# =============================================================================
# QMS — environment configuration (template)
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed — it holds the DB password.
# Real environment variables take precedence over anything set here.
#
# ⚠ THIS FILE IS TRACKED IN GIT. Every value here is either a safe local-dev
#   default or blank. A secret is left BLANK, with a comment saying how to make
#   one — never a sample value, because a sample value gets deployed.
#
# docs/ENVIRONMENT.md is the full list — every variable the application reads,
# what it defaults to, and which ones are mandatory in production.

# ── MySQL ────────────────────────────────────────────────────────────────────
# DB_ENABLED=false runs the app entirely in memory (data lost on restart).
DB_ENABLED=true

# DB_STRICT=true refuses to start when MySQL is unreachable, instead of quietly
# falling back to in-memory. Turn this on once you rely on the data.
DB_STRICT=false

DB_HOST=127.0.0.1
DB_PORT=3306
# The database is created on first boot if it does not exist.
DB_NAME=qms
DB_USER=root
# <your MySQL password>
DB_PASSWORD=

# ── Flask ────────────────────────────────────────────────────────────────────
# Signs the session cookie. LEAVE IT BLANK HERE and set it in `.env` only.
# Generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Blank means "not supplied": the app then uses `secret_key.txt` beside the
# code (minting one if absent) and prints a loud startup banner saying so.
# `SECRET_KEY` (the bare name) is honoured too, for hosts that already set it.
QMS_SECRET_KEY=

# ── Bind address (the dev server in app.py; gunicorn takes its own) ──────────
# QMS_HOST / QMS_PORT, or the bare HOST / PORT if your host sets those.
# 127.0.0.1 is deliberate: `python app.py` runs Werkzeug with debug on, which
# must never listen on a public interface. Use wsgi.py in production.
QMS_HOST=127.0.0.1
QMS_PORT=5000

# ── Attachment store (the files live on disk, not in MySQL) ─────────────────
# Blank means `<repo>/attachments`. On a real server put it OUTSIDE the
# checkout, so a redeploy cannot delete the uploaded files.
# ⚠ A backup of this application is the database AND this directory together —
#   tools/backup_db.py writes both halves under one stamp.
ATTACHMENT_DIR=

# ── Session cookie flags ─────────────────────────────────────────────────────
# The defaults here are the LOCAL-DEV values. SESSION_COOKIE_SECURE=false is
# required for http://127.0.0.1 — a Secure cookie is never sent over plain HTTP,
# so a browser silently drops it and nobody can sign in.
#
# ⚠ SESSION_COOKIE_SECURE=true IS MANDATORY IN PRODUCTION.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ── Demo data (ABOUT.md §7 gap 35) ───────────────────────────────────────────
# The INTERLOCK on the demo seed: `python tools/seed_demo.py` builds the
# fictional sample company only when this is true AND the database is empty.
# Nothing is ever seeded by visiting a page.
#
# ⚠ THE CODE DEFAULT IS **false**, unlike every other flag in this file — a
#   production box where nobody set it must not grow data nobody typed. This
#   line is `true` because this is the DEV template.
#
# ⚠ ON A PRODUCTION .env THIS MUST BE `false` (or simply absent).
QMS_DEMO_DATA=true

# ── GSTIN auto-fill fallback (gst_lookup.py) ─────────────────────────────────
# OPTIONAL. The address book asks the GST portal first, with a CAPTCHA the user
# types; this key is only for when the PORTAL fails, and then gstinapi.in is
# asked instead. Unset: a portal failure says "Auto-fill unavailable, enter
# manually." Every successful call spends a paid credit. docs/ENVIRONMENT.md.
# <your gstinapi.in key>
# GST_API_KEY=

# ── Single worker, enforced ───────────────────────────────────────────────────
# STORE is one dict in ONE process's RAM. Two workers = two divergent copies of
# the whole application state, overwriting each other with no error at all.
# wsgi.py refuses to start under a second worker. This is the override, and it
# exists only so the refusal can be tested — never set it on a real server.
# QMS_ALLOW_MULTIPROCESS=
# Where wsgi.py keeps its single-worker lock file (diagnostics only).
# QMS_LOCK_FILE=

# ── Tooling only — read by scripts in tools/, never by the application ───────
# tools/seed_users.py and tools/set_password.py take the password from these
# when --password is not given. Never leave one set on a shared box.
# QMS_SEED_PASSWORD=
# QMS_NEW_PASSWORD=
# tools/e2e_chain.py signs in as three accounts (creator + two approvers).
# QMS_E2E_USER_A=
# QMS_E2E_PASS_A=
# QMS_E2E_USER_B=
# QMS_E2E_PASS_B=
# QMS_E2E_USER_C=
# QMS_E2E_PASS_C=
